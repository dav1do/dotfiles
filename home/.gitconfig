[credential]
        username = dav1do
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[user]
        name = David Estes
        email = 5317198+dav1do@users.noreply.github.com 
	signingkey = C3EACD65B4D7E164 
[commit]
	gpgsign = true
	verbose = true
[tag]
	gpgSign = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	minus-style = "syntax \"#3a2a2c\""
	minus-emph-style = "syntax bold \"#7a3a3c\""
	plus-style = "syntax \"#2a3a2c\""
	plus-emph-style = "syntax bold \"#3a7a3c\""
	keep-plus-minus-markers = true
	syntax-theme = "gruvbox-dark"
[merge]
	conflictStyle = zdiff3
[credential "https://dev.azure.com"]
	useHttpPath = true
[fetch]
	prune = true
	pruneTags = true
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	updateRefs = true 
	autoSquash = true
	autoStash = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
# auto apply resolution the same way next time.. not 100% on this one
[rerere]
	enabled = true
