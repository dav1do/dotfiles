{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git diff:*)",
      "Bash(git log *)",
      "Bash(git log:*)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(git status:*)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(sqitch add:*)",
      "Bash(sqitch status:*)",
      "Bash(sqitch verify:*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Read",
      "WebSearch",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo machete *)",
      "Bash(cargo sqlx *)",
      "Bash(cargo test *)",
      "Bash(make *)",
      "Bash(sqitch status *)",
      "Bash(sqitch verify *)",
      "Bash(docker compose * ps *)",
      "Bash(docker compose * logs *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:developers.glean.com)",
      "WebFetch(domain:api.anthropic.com)",
      "mcp__postgres__query",
      "Bash(bat *)",
      "Bash(cargo llvm-cov *)",
      "Bash(cargo tree *)",
      "Bash(delta *)",
      "Bash(fd *)",
      "Bash(glow *)",
      "Bash(hyperfine *)",
      "Bash(pandoc *)",
      "Bash(ruff *)",
      "Bash(scc *)",
      "Bash(shfmt *)",
      "Bash(sqldiff *)",
      "Bash(stylua *)",
      "Bash(taplo *)",
      "Bash(tldr *)",
      "Bash(tmux capture-pane *)",
      "Bash(tmux display-message *)",
      "Bash(tmux list-panes *)",
      "Bash(tmux list-sessions *)",
      "Bash(tmux list-windows *)",
      "Bash(toolchain-check*)",
      "Bash(typst compile *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl *| bash*)",
      "Bash(curl *| sh*)",
      "Bash(curl *| zsh*)",
      "Bash(curl *| source*)",
      "Bash(wget *| bash*)",
      "Bash(wget *| sh*)",
      "Bash(wget *| zsh*)",
      "Bash(wget *| source*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(pulumi up)",
      "Bash(pulumi up *)",
      "Bash(pulumi destroy)",
      "Bash(pulumi destroy *)",
      "Bash(pulumi refresh)",
      "Bash(pulumi refresh *)",
      "Bash(docker push *)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Bash(osascript *)",
      "Bash(defaults write *)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/application_default_credentials.json)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/gha-creds-*.json)",
      "Read(**/*-gcs-key.json)",
      "Read(**/.env.prod*)",
      "Read(**/.env.staging*)",
      "Edit(**/.env.prod*)",
      "Edit(**/.env.staging*)",
      "Write(**/.env.prod*)",
      "Write(**/.env.staging*)"
    ],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(brew install *)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/worktree-setup.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "security-hooks@ukon-plugins": true
  },
  "extraKnownMarketplaces": {},
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "editorMode": "vim",
  "autoScrollEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "color": "purple"
}
