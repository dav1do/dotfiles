{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(gh api repos/*/pulls/*/reviews *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(git grep *)",
      "Bash(git worktree list *)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(pg_isready *)",
      "Read",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:api.anthropic.com)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "danny-badger": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/david/.claude/hooks/worktree-setup.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash /Users/david/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "session-report@claude-plugins-official": true,
    "security-hooks@ukon-plugins": true,
    "design-html@ukon-plugins": true,
    "review-pr@ukon-plugins": true,
    "ukon-test-db@ukon-plugins": true,
    "posthog@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Blunt",
  "sandbox": {
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.git-credentials",
        "~/.cargo/credentials.toml",
        "~/.cargo/credentials",
        "~/.pypirc",
        "~/.zsh_history",
        "~/ukon/**/.env.prod*",
        "~/ukon/**/.env.staging*",
        "~/ukon/**/*.pem",
        "~/ukon/**/*.key",
        "~/ukon/**/*.p12",
        "~/ukon/**/*.pfx",
        "~/ukon/**/gha-creds-*.json",
        "~/ukon/**/*-gcs-key.json"
      ],
      "allowWrite": [
        "/Users/david/ukon/active/ukon-core/.claude/worktrees",
        "/Users/david/ukon/active/ukon-core/.claude/skills",
        "/Users/david/.cargo"
      ],
      "denyWrite": [
        "/Users/david/.cargo/bin",
        "/Users/david/.cargo/config.toml",
        "/Users/david/.cargo/credentials.toml",
        "/Users/david/.cargo/credentials"
      ]
    },
    "excludedCommands": [
      "bash ~/ukon/active/mgmt/.claude/skills/morning-prep/gather.sh*",
      "bash /Users/david/ukon/active/mgmt/.claude/skills/morning-prep/gather.sh*",
      "./clickup_stats.py *"
    ]
  },
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": false,
  "autoScrollEnabled": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "color": "purple"
}
