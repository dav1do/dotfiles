#!/usr/bin/env bash
# Centered reading view of a file. Markdown is rendered (glow), anything else is
# highlighted source (bat). Read-only, so it can't fight the helix instance
# still holding the buffer.
#
#   tmux-read --popup FILE    bordered overlay, gone when you quit
#   tmux-read --float FILE    covers the window and persists (--window is an alias)
#
# Runs twice: the outer run builds the frame, the inner run (--render) is the
# reader inside it.
set -euo pipefail

# The text measure, in columns — not the pane width. No floor: a measure wider
# than the pane makes glamour hard-wrap and the terminal soft-wrap again.
# glamour keeps a paragraph's source line breaks, so these only change where the
# column sits until they drop below the width the file was written at (~88 here).
readonly MIN_WIDTH=100
readonly MAX_WIDTH=120
readonly TABLE_WIDTH=150
readonly POPUP_HEIGHT=90%

readonly GLOW_CONFIG="$HOME/Library/Preferences/glow/glow.yml"

is_markdown() {
  [[ ${1,,} == *.md || ${1,,} == *.markdown || ${1,,} == *.mdx ]]
}

has_table() {
  grep -qE '^[[:space:]]*\|' -- "$1"
}

# A popup can't be resized, so its width is fixed at launch and passed in as
# READ_WIDTH; a float asks tmux, which is what makes re-render re-wrap.
pane_cols() {
  local cols=${READ_WIDTH:-}
  if [[ -z $cols ]]; then
    cols=$(tmux display -p -t "${TMUX_PANE:-}" '#{pane_width}' 2>/dev/null) || cols=
    [[ $cols =~ ^[1-9][0-9]*$ ]] || cols=$MIN_WIDTH
  fi
  echo "$cols"
}

text_column() {
  local file=$1 cols=$2 w
  # Tables get most of the pane: glamour draws no rule between rows (BorderRow
  # is left off, with no style key to set it), so narrow cells that wrap three
  # or four times become unreadable. Width is the only lever.
  if is_markdown "$file" && has_table "$file"; then
    w=$TABLE_WIDTH
  else
    w=$MAX_WIDTH
  fi
  ((w > cols)) && w=$cols
  echo "$w"
}

# Nothing if glow's style isn't a real file ("auto" is the default and has no
# JSON to borrow from).
glow_style_path() {
  local p
  p=$(sed -n 's/^style:[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' \
    "$GLOW_CONFIG" 2>/dev/null | head -1) || return 1
  [[ -n $p && $p == /* && -f $p ]] || return 1
  echo "$p"
}

render() {
  local file=$1 cols column margin style dir tmp pad
  cols=$(pane_cols)
  column=$(text_column "$file" "$cols")
  # glamour's document.margin is symmetric: it indents by margin AND shrinks the
  # wrap to width - 2*margin. So -w is the pane, not the measure.
  margin=$(((cols - column) / 2))

  if is_markdown "$file"; then
    if ((margin > 0)) && style=$(glow_style_path); then
      # A directory: BSD mktemp only substitutes a TRAILING XXXXXX. Double
      # quotes so the path is baked into the trap now — by EXIT the local is out
      # of scope and rm would get an empty argument.
      dir=$(mktemp -d "${TMPDIR:-/tmp}/tmux-read.XXXXXX")
      trap "rm -rf '$dir'" EXIT
      tmp=$dir/style.json
      jq --argjson m "$margin" '.document.margin = $m' "$style" >"$tmp"
      # -p is glow's own pager; q closes it, which closes the popup or float.
      glow -p -w "$cols" -s "$tmp" -- "$file"
    else
      # No style JSON to patch means no margin to set — wrap at the measure and
      # live with left-aligned.
      glow -p -w "$column" -- "$file"
    fi
    return
  fi

  # bat has no margin, so centering means indenting its output into less rather
  # than letting bat page it. To read a markdown file's source instead of the
  # rendered version, make is_markdown return false.
  if ((margin > 0)); then
    pad=$(printf '%*s' "$margin" '')
    bat --color=always --paging=never --style=numbers,changes \
      --terminal-width "$column" -- "$file" |
      sed "s/^/$pad/" | less -R
  else
    bat --paging=always --style=numbers,changes --terminal-width "$column" -- "$file"
  fi
}

open_popup() {
  # The popup IS the reading column, so there's no slack and no margin.
  local width=$MAX_WIDTH
  ((width > win_width)) && width=$win_width
  exec tmux display-popup -E -w "$width" -h "$POPUP_HEIGHT" \
    -T " $(basename "$file") " \
    -e "READ_WIDTH=$width" \
    "$(printf '%q %q --render %q' bash "$self" "$file")"
}

open_float() {
  local pane cmd bg
  cmd=$(printf '%q %q --render %q' bash "$self" "$file")
  # new-pane's -S/-R take a literal style and don't expand formats the way
  # set-option -F does, so resolve catppuccin's colour here or skip the styling.
  bg=$(tmux display -p '#{@thm_bg}' 2>/dev/null) || bg=
  [[ $bg == '#'* ]] || bg=

  # The inset isn't cosmetic: the float must fit inside the window WITH its
  # border, and the full window_width/window_height is rejected as "size or
  # position invalid". All four values must be plain integers — adding -X C -Y C
  # fails, so display-popup's centre keywords don't carry over to a pane.
  local inset=1 w h err
  w=$((win_width - inset * 2))
  h=$((win_height - inset * 2))

  local geo=(-x "$w" -y "$h" -X "$inset" -Y "$inset")
  [[ -n $bg ]] && geo+=(-S "fg=$bg" -R "fg=$bg")

  # Not a silent fallback: a bare `new-pane` hands back tmux's default half-size
  # float and looks like the geometry worked.
  if ! pane=$(tmux new-pane -P -F '#{pane_id}' "${geo[@]}" "$cmd" 2>&1); then
    err=$pane
    tmux display-message "tmux-read: ${w}x${h}+${inset}+${inset} rejected — $err"
    pane=$(tmux new-pane -P -F '#{pane_id}' "$cmd")
  fi

  # Pane-scoped so the hook dies with the pane. respawn-pane -k re-runs this
  # command, re-reading the file, the width and the margin; tmux does the
  # teardown, so nothing kills a pager mid-draw from the inside.
  tmux set-hook -p -t "$pane" after-resize-pane \
    "respawn-pane -k -t $pane" 2>/dev/null || true
}

open_window() { open_float; }

if [[ ${1:-} == --render ]]; then
  render "$2"
  exit
fi

mode=float
case ${1:-} in
  --popup | --float | --window)
    mode=${1#--}
    shift
    ;;
esac

file=${1:?usage: tmux-read [--popup|--float] FILE}
[[ -n ${TMUX:-} ]] || {
  echo "tmux-read: not inside tmux" >&2
  exit 1
}
# Rejects directories too: a helix scratch buffer with no path expands to cwd.
[[ -f $file && -r $file ]] || {
  echo "tmux-read: nothing to read at $file" >&2
  exit 1
}

win_width=$(tmux display -p -t "${TMUX_PANE:-}" '#{window_width}')
win_height=$(tmux display -p -t "${TMUX_PANE:-}" '#{window_height}')

# $0 is a bare name when found on PATH, and the popup/new pane may not share
# that PATH. Re-entered through `bash` so the file needs no exec bit.
self=$0
[[ $self == */* ]] || self=$(command -v "$0")

"open_$mode"
